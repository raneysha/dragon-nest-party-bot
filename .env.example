DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
# Optional: set this to a server ID while testing so slash commands register instantly.
# Leave blank to register commands globally (takes up to 1 hour to propagate).
GUILD_ID=
# Optional: set this to a channel ID to always create "Finish" loot recap
# threads in that specific channel, regardless of which channel the party
# was posted in. Leave blank to create the thread in the same channel as
# the party (default behavior).
LOOT_THREAD_CHANNEL_ID=
